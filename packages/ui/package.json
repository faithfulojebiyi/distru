{
  "name": "@ops/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    },
    "./source-alias": "./source-alias.ts"
  },
  "scripts": {
    "codegen": "panda codegen",
    "lib": "panda codegen && panda lib",
    "watch": "panda codegen && panda lib --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "luxon": "^3.7.2",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react-day-picker": "^10.0.1",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^4.12.3",
    "react-tag-input": "^6.10.6",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "streamdown": "2.7.1",
    "thinking-orbs": "0.3.2",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tanstack/react-router": "^1.170.32"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@types/luxon": "^3.7.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
