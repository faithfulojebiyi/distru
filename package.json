{
  "name": "distru-ops-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:mock": "bun run --cwd apps/distru-mock dev",
    "inngest:dev": "bun run --cwd apps/agent inngest:dev",
    "studio": "bun run --cwd apps/agent studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "dev:headset": "bun run --cwd apps/headset-mock dev",
    "dev:emulators": "bun run --cwd apps/emulators dev",
    "evals": "bun run --cwd packages/evals evals",
    "evals:live": "bun run --cwd packages/evals evals:live",
    "dev:apps": "bun run --filter './apps/*' dev"
  }
}
