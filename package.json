{
  "name": "distru-ops-agent",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "bun": ">=1.4.0" },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:agent": "bun run --cwd apps/agent dev",
    "dev:mock": "bun run --cwd apps/distru-mock dev",
    "inngest:dev": "bunx inngest-cli@latest dev -u http://localhost:4111/api/inngest --no-discovery",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  }
}
