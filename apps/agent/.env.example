# --- Server ---
NODE_ENV=development
PORT=4111

# --- Database (root docker-compose.yml) ---
DATABASE_URL=postgres://ops:ops@127.0.0.1:5482/ops

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:4111
# Comma-separated browser origins allowed to call the API with cookies
WEB_ORIGIN=http://localhost:3050
# Standalone Mastra Studio (`bun run studio`); CORS-allowed in development only
STUDIO_ORIGIN=http://localhost:3000

# --- Model provider (optional: server boots without it) ---
ANTHROPIC_API_KEY=
OPS_AGENT_MODEL=anthropic/claude-sonnet-5-5
# Per-agent overrides (default: OPS_AGENT_MODEL)
# OPS_LEAD_MODEL=
# INVENTORY_ANALYST_MODEL=
# PROCUREMENT_PLANNER_MODEL=
# COMPLIANCE_REVIEWER_MODEL=
# POLICY_CRITIC_MODEL=
# Cost estimate used for budgets and the run timeline (USD per million tokens)
# LLM_INPUT_USD_PER_MTOK=3
# LLM_OUTPUT_USD_PER_MTOK=15

# --- Distru (mock by default) ---
DISTRU_BASE_URL=http://localhost:4500/public/v1
DISTRU_API_TOKEN=mock-token
# HMAC secret for x-distru-signature on POST /api/webhooks/distru (mock default: mock-webhook-secret; required in production)
DISTRU_WEBHOOK_SECRET=mock-webhook-secret

# --- Distru MCP bridge (connector `distru_mcp`; allocation guard writes go through it) ---
# Local mock by default; set to https://mcp.distru.com/mcp with a real key for Distru. Empty = disabled.
# If the server is down at boot the agent starts without it (GET /api/connectors shows it unhealthy)
# and retries every DISTRU_MCP_REFRESH_MS, rebuilding the registry when it comes back.
DISTRU_MCP_URL=http://localhost:4500/mcp
DISTRU_MCP_KEY=distru_mcp_mock
# DISTRU_MCP_REFRESH_MS=60000

# --- Retail analytics (Headset-style mock, `bun run dev:headset`) ---
HEADSET_BASE_URL=http://localhost:4600
HEADSET_API_TOKEN=headset-mock-token

# --- Vendor email (connector `email`) ---
# Unset RESEND_API_KEY = in-memory mock outbox (nothing is sent). With a key, EMAIL_FROM is required.
RESEND_API_KEY=
# EMAIL_FROM=Golden Coast Purchasing <purchasing@goldencoastdistro.com>

# --- Restock hand-off ---
# Distru role whose user gets the "Receive PO-… on <date>" task
# RESTOCK_TASK_OWNER_ROLE=Purchasing Manager
# Google Sheet the restock proposal appends one row per PO line to (Composio sheets.append_rows; empty disables)
# RESTOCK_REORDER_LOG_SPREADSHEET=1GcWeeklyReorderLog0goldencoast0000000000000
# RESTOCK_REORDER_LOG_SHEET=Reorders

# --- Context layer (packages/context): Distru sync → account profile (Inngest cron; empty disables) ---
# CONTEXT_SYNC_CRON=*/30 * * * *

# --- Semantic recall (pgvector + local FastEmbed; `bun run recall:index` for a manual pass) ---
# RECALL_ENABLED=1                 # 0 disables the recall connector, indexing and Copilot semanticRecall
# RECALL_EMBEDDER=fastembed        # or hash (lexical, no model download)
# RECALL_INDEX_CRON=*/15 * * * *   # incremental mailbox pass; empty disables (arrivals still indexed)

# --- Restock triggers ---
# 1 = register the morning restock cron with Inngest
RESTOCK_CRON_ENABLED=
RESTOCK_CRON=TZ=America/Los_Angeles 0 7 * * *

# --- Tracing (OpenTelemetry, off unless the endpoint is set) ---
# Agent runs, model and tool calls, workflow steps and harness spans (propose, policy, decide, execute,
# write, verify) over OTLP/HTTP. Local Jaeger: `docker compose --profile observability up -d`, UI on :16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...   # comma-separated key=value, for hosted backends
# OTEL_SERVICE_NAME=ops-agent

# --- Inngest ---
# Local: INNGEST_DEV=1 talks to `bun run inngest:dev` (http://localhost:8288). Never set in production.
INNGEST_DEV=1
# Production (Inngest Cloud) only:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Vendor-reply loop: Composio (connector `composio`, Gmail trigger) ---
# Defaults point at the local emulator (`bun run dev:emulators`, http://localhost:4700).
# Real Composio: real key, COMPOSIO_BASE_URL= (empty), your user id, and the trigger + webhook subscription
# created in the Composio dashboard (its signing secret goes in COMPOSIO_WEBHOOK_SECRET). Empty key = disabled.
COMPOSIO_API_KEY=ak_emulator_goldencoast_local0001
COMPOSIO_BASE_URL=http://localhost:4700
COMPOSIO_USER_ID=golden-coast
# COMPOSIO_TOOLKITS=gmail,googlecalendar,googlesheets
# Known spreadsheets (Name=id, comma-separated; leading + = appendable by sheets.append_rows)
# COMPOSIO_GOOGLESHEETS_SPREADSHEETS=Vendor price sheet=1GcVendorPriceSheet0goldencoast0000000000000,+Weekly reorder log=1GcWeeklyReorderLog0goldencoast0000000000000
COMPOSIO_WEBHOOK_SECRET=whsec_emulator_goldencoast_local
# COMPOSIO_REFRESH_MS=60000
# VENDOR_LIAISON_MODEL=

# --- Slack approvals + run notifications (emulator by default) ---
# Real Slack: real bot token, SLACK_API_URL= (empty), the app's signing secret, and point the app's
# interactivity URL at https://<host>/api/webhooks/slack. Empty token = Slack disabled.
SLACK_BOT_TOKEN=xoxb-emulator-goldencoast-ops-agent
SLACK_API_URL=http://localhost:4700/slack/api/
SLACK_SIGNING_SECRET=emulator-slack-signing-secret
SLACK_APPROVALS_CHANNEL=#ops-approvals
SLACK_NOTIFY_CHANNEL=#purchasing
# Dashboard origin for links in Slack (default: first WEB_ORIGIN)
# WEB_BASE_URL=http://localhost:3050

# --- MCP server (/mcp), undo, A2A ---
# Base URL shown with a new MCP token (`<url>/mcp`); default BETTER_AUTH_URL.
# PUBLIC_URL=http://localhost:4111
# Executed proposals can be undone (POST /api/proposals/:id/undo → a new proposal) for this many hours.
UNDO_WINDOW_HOURS=168
