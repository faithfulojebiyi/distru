# --- Server ---
NODE_ENV=development
PORT=4111

# --- Database (root docker-compose.yml) ---
DATABASE_URL=postgres://ops:ops@127.0.0.1:5482/ops

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:4111
# Comma-separated browser origins allowed to call the API with cookies
WEB_ORIGIN=http://localhost:3050

# --- Model provider (optional: server boots without it) ---
ANTHROPIC_API_KEY=
OPS_AGENT_MODEL=anthropic/claude-sonnet-5-5

# --- Distru (mock by default) ---
DISTRU_BASE_URL=http://localhost:4500/public/v1
DISTRU_API_TOKEN=mock-token

# --- Inngest ---
# Local: INNGEST_DEV=1 talks to `bun run inngest:dev` (http://localhost:8288). Never set in production.
INNGEST_DEV=1
# Production (Inngest Cloud) only:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
