{
  "name": "@ops/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:push": "bun scripts/db-extensions.ts && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/db-extensions.ts && bun src/db/seed.ts",
    "db:seed:history": "bun scripts/seed-history.ts",
    "db:seed:history:reset": "bun scripts/seed-history.ts --reset",
    "verify:hello": "bun scripts/verify-hello-workflow.ts",
    "inngest:dev": "npx --yes --ignore-scripts=false inngest-cli@latest dev -u http://localhost:4111/api/inngest --no-discovery",
    "studio": "mastra studio",
    "restock:demo": "bun scripts/restock-demo.ts",
    "mcp:smoke": "bun scripts/mcp-smoke.ts",
    "titles:backfill": "bun scripts/backfill-titles.ts",
    "context:sync": "bun scripts/context-sync.ts",
    "db:extensions": "bun scripts/db-extensions.ts",
    "recall:index": "bun scripts/recall-index.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@mastra/core": "~1.85.0",
    "@mastra/evals": "~1.10.11",
    "@mastra/fastembed": "1.3.7",
    "@mastra/hono": "~1.7.27",
    "@mastra/inngest": "~1.11.4",
    "@mastra/mcp": "~2.10.0",
    "@mastra/memory": "~1.41.2",
    "@mastra/observability": "~1.24.2",
    "@mastra/pg": "~1.37.0",
    "@mastra/server": "1.85.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@ops/connector-composio": "workspace:*",
    "@ops/connector-distru": "workspace:*",
    "@ops/connector-email": "workspace:*",
    "@ops/connector-headset": "workspace:*",
    "@ops/connector-mcp": "workspace:*",
    "@ops/context": "workspace:*",
    "@ops/distru-client": "workspace:*",
    "@ops/harness": "workspace:*",
    "@slack/web-api": "8.2.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.4",
    "fetch-to-node": "2.1.0",
    "hono": "^4.13.19",
    "inngest": "~4.26.2",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ops/distru-mock": "workspace:*",
    "@ops/emulators": "workspace:*",
    "@ops/emulators-server": "workspace:*",
    "@ops/headset-mock": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "mastra": "~1.40.1",
    "typescript": "^6.0.3"
  }
}
