{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ops/ui/*": [
        "../../packages/ui/src/*",
        "../../packages/ui/styled-system/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "orval.config.ts"
  ],
  "exclude": [
    "src/styled-system",
    "src/**/*.test.ts",
    "node_modules"
  ]
}
